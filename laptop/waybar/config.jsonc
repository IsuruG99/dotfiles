{
  "layer": "top",
  "position": "top",
  "height": 28,
  "spacing": 0,
  "margin": "6px 8px 0px 8px",

    "modules-left": [
        "cpu",
        "memory"
    ],

    "modules-center": [
        "hyprland/workspaces"
    ],

    "modules-right": [
        "network",
        "pulseaudio",
        "clock",
        "tray"
    ],

    "hyprland/workspaces": {
        "format": "{icon}",
        "on-click": "activate"
    },

    "cpu": {
        "format": "CPU {usage}%",
        "interval": 5
    },

    "memory": {
        "format": "RAM {used:0.1f}G",
        "interval": 5
    },

    "network": {
        "format-wifi": "{essid} {signalStrength}%",
        "format-ethernet": "{ipaddr}",
        "format-disconnected": "Offline",
        "tooltip": false,
        "interval": 5,
        "on-click": "nm-connection-editor"
    },

    "pulseaudio": {
        "format": "{volume}% {icon}",
        "format-muted": "Muted",
        "format-icons": {
            "default": ["", "", ""]
        },
        "scroll-step": 5
    },

    "clock": {
        "format": "{:%I:%M %p}",
        "interval": 30
    },
    "tray": {
      "spacing": 6
  }
}
