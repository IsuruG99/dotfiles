{
  "layer": "top",
  "position": "top",
  "height": 30,
  "spacing": 0,
  "margin": "5px 5px 0px 5px",

    "modules-left": [
        "cpu",
        "memory",
        "custom/return"
    ],

    "modules-center": [
        "hyprland/workspaces",
    ],

    "modules-right": [
        "network",
        "pulseaudio",
        "clock",
        "battery",
        "tray"
    ],

    "hyprland/workspaces": {
        "format": "{icon}",
        "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 1 })'"
    },

    "custom/return": {
      "format": "0",
      "on-click": "hyprctl dispatch 'hl.dsp.focus({ workspace = 1 })'"
    },

    "cpu": {
        "format": "CPU {usage}%",
        "interval": 5
    },

    "memory": {
        "format": "RAM {used:0.1f}G",
        "interval": 5
    },

    "network": {
        "format-wifi": "{essid} {signalStrength}%",
        "format-ethernet": "{ipaddr}",
        "format-disconnected": "Offline",
        "format-disabled": "Disabled",
        "tooltip": false,
        "interval": 5,
        "on-click": "nmgui"
    },

    "battery": {
        "format": "{capacity}% {icon}",
        "format-charging": "{capacity}% 󰂄",
        "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "interval": 10,
        "tooltip": false
    },

    "pulseaudio": {
        "format": "{volume}% {icon}",
        "format-muted": "Muted",
        "format-icons": {
            "default": ["", "", ""]
        },
        "scroll-step": 5,
        "on-click": "pavucontrol"
    },

    "clock": {
        "format": "{:%I:%M %p}",
        "interval": 30
    },
    "tray": {
      "spacing": 6
  }
}
