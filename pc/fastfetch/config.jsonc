{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/images/*.png",
        "type": "kitty",
        "width": 11,
        "height": 6,
        "padding": {
            "top": 0,
            "left": 2,
            "right": 4 
        }
    },
    "display": {
        "separator": " ",
        "color": {
            "title": "#56b6c2",
            "keys": "#56b6c2"
        }
    },
    "modules": [
        "break",
        "break",
        {
            "type": "command",
            "key": " ",
            "text": "shuf -n 1 ~/.config/fastfetch/quotes.txt | fold -s -w $(( $(tput cols) - 35 )) | awk 'NR==1 {print} NR>1 {print \"                  \" $0}'"
        },
        "break",
        "break"
    ]
}
